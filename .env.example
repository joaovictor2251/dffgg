PORT=3000
# Mercado Pago subscriptions and one-time gift payments (requires public HTTPS and persistent storage)
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PUBLIC_APP_URL=https://seu-dominio.com.br
# Kiwify API credentials with sales-read/financial scopes and account ID
KIWIFY_CLIENT_ID=
KIWIFY_CLIENT_SECRET=
KIWIFY_ACCOUNT_ID=
# Kiwify webhook token from the webhook configuration
KIWIFY_WEBHOOK_TOKEN=
# Cakto API key with read payments and withdrawals_write scopes
CAKTO_CLIENT_ID=
CAKTO_CLIENT_SECRET=
# Cakto webhook signing secret
CAKTO_WEBHOOK_SECRET=
